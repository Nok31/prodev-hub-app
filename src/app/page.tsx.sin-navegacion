      <div className="p-4 space-y-3">
        <div className="text-base font-bold text-white">Hub 🔒</div>
        <div className="flex items-center justify-between pt-1 border-t border-slate-800 text-xs text-slate-400">
          <span>👥 BQ · FF · AP</span>
